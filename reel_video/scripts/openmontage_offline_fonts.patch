@@ -0,0 +1,4 @@
+// Offline fonts: the render browser can't reach fonts.gstatic.com through this network, so the fonts are
+// bundled in public/gfonts. They are preloaded once at bundle start (preload.ts, imported by index.tsx);
+// loadFont() keeps the @remotion/google-fonts API shape and only returns the family name.
+export const makeLoader = (family: string) => () => ({ fontFamily: family });
diff --git a/remotion-composer/src/gf/preload.ts b/remotion-composer/src/gf/preload.ts
new file mode 100644
index 0000000..5c209cc
--- /dev/null
+++ b/remotion-composer/src/gf/preload.ts
@@ -0,0 +1,18 @@
+// Bundled fonts as plain CSS @font-face (no delayRender: a module-level render handle hangs in multi-frame renders here).
+import { staticFile } from "remotion";
+
+const FILES: [string, string, string][] = [
+  ["Space Grotesk", "normal", "SpaceGrotesk-normal.woff2"],
+  ["Playfair Display", "normal", "PlayfairDisplay-normal.woff2"],
+  ["Playfair Display", "italic", "PlayfairDisplay-italic.woff2"],
+];
+
+if (typeof document !== "undefined" && !document.getElementById("om-gfonts")) {
+  const style = document.createElement("style");
+  style.id = "om-gfonts";
+  style.textContent = FILES.map(
+    ([family, st, file]) =>
+      `@font-face{font-family:'${family}';font-style:${st};font-weight:100 900;font-display:block;src:url(${staticFile(`gfonts/${file}`)}) format('woff2');}`,
+  ).join("\n");
+  document.head.appendChild(style);
+}
